{% extends 'base.html.twig' %}

{% block title %}Уведомления{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="fa fa-bell me-2"></i>Уведомления</h2>
            {% if notifications|length > 0 %}
                <button id="mark-all-btn" class="btn btn-outline-secondary btn-sm">
                    Прочитать все
                </button>
            {% endif %}
        </div>

        {% if notifications|length == 0 %}
            <div class="card p-4 text-center text-muted">
                <i class="fa fa-bell-slash fa-3x mb-3"></i>
                <p>Нет непрочитанных уведомлений</p>
            </div>
        {% else %}
            <div id="notification-list">
                {% for notification in notifications %}
                    <div class="card mb-2 notification-item" id="n-{{ notification.id }}">
                        <div class="card-body d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-{{ notification.type == 'news' ? 'primary' : 'secondary' }} me-2">
                                    {{ notification.type }}
                                </span>
                                {{ notification.message }}
                                <br>
                                <small class="text-muted">{{ notification.createdAt|date('d.m.Y H:i') }}</small>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary mark-read-btn"
                                    data-id="{{ notification.id }}">
                                <i class="fa fa-check"></i>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.mark-read-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        const id = this.dataset.id;
        fetch(`/notifications/${id}/read`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(() => document.getElementById(`n-${id}`).remove());
    });
});

const markAllBtn = document.getElementById('mark-all-btn');
if (markAllBtn) {
    markAllBtn.addEventListener('click', function() {
        fetch('/notifications/mark-all-read', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(() => {
                document.getElementById('notification-list').innerHTML =
                    '<div class="card p-4 text-center text-muted"><p>Нет непрочитанных уведомлений</p></div>';
                markAllBtn.remove();
            });
    });
}
</script>
{% endblock %}
