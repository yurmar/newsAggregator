{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} — NewsAgg{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">

    {# Breadcrumb #}
    <div class="flex items-center gap-2 text-xs text-[var(--muted-foreground)] mb-6">
        <a href="{{ path('app_article_index') }}"
           class="hover:text-[var(--foreground)] transition-colors no-underline">Новости</a>
        <span>/</span>
        {% if article.category %}
            <a href="{{ path('app_article_index', {category: article.category.slug}) }}"
               class="hover:text-[var(--foreground)] transition-colors no-underline">
                {{ article.category.name }}
            </a>
            <span>/</span>
        {% endif %}
        <span class="truncate max-w-xs">{{ article.title }}</span>
    </div>

    <article class="card p-8">

        {% if article.category %}
            <a href="{{ path('app_article_index', {category: article.category.slug}) }}"
               class="badge no-underline hover:bg-[var(--accent)] transition-colors">
                {{ article.category.name }}
            </a>
        {% endif %}

        <h1 class="mt-4 text-2xl font-bold leading-tight text-[var(--foreground)]">
            {{ article.title }}
        </h1>

        <div class="flex items-center gap-4 mt-3 text-xs text-[var(--muted-foreground)]">
            <span class="flex items-center gap-1">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {{ article.publishedAt|date('d.m.Y H:i') }}
            </span>
            {% if article.source %}
                <span class="flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
                    </svg>
                    {{ article.source.name }}
                </span>
            {% endif %}
        </div>

        {% if article.imageUrl %}
            <div class="mt-6 rounded-lg overflow-hidden bg-[var(--muted)]">
                <img src="{{ article.imageUrl }}" alt="{{ article.title }}"
                     class="w-full max-h-96 object-cover"
                     onerror="this.parentElement.style.display='none'">
            </div>
        {% endif %}

        {% if article.summary %}
            <p class="mt-6 text-base text-[var(--muted-foreground)] leading-relaxed font-medium border-l-2 border-[var(--border)] pl-4">
                {{ article.summary }}
            </p>
        {% endif %}

        {% if article.content %}
            <div class="mt-6 text-sm text-[var(--foreground)] leading-relaxed space-y-3">
                {{ article.content|nl2br }}
            </div>
        {% endif %}

        <div class="mt-8 pt-6 border-t border-[var(--border)] flex items-center justify-between gap-4">
            <a href="{{ path('app_article_index') }}" class="btn btn-secondary">
                ← Назад
            </a>
            <a href="{{ article.externalUrl }}" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary no-underline">
                Читать на источнике
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
            </a>
        </div>
    </article>
</div>
{% endblock %}
