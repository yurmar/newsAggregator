{% extends 'base.html.twig' %}

{% block title %}Новости{% if currentCategory %} — {{ currentCategory.name }}{% endif %}{% endblock %}

{% block body %}

{# Search field #}
<div class="relative mb-6">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--muted-foreground)] pointer-events-none"
         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
        id="search-input"
        type="text"
        placeholder="Поиск новостей по заголовку, аннотации и тексту…"
        autocomplete="off"
        data-search-url="{{ path('app_article_search') }}"
        class="pl-10 pr-10 h-10 text-sm"
    >
    <div id="search-spinner" class="hidden absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
        <svg class="animate-spin w-4 h-4 text-[var(--muted-foreground)]" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity="0.25"/>
            <path d="M4 12a8 8 0 0 1 8-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
        </svg>
    </div>
</div>

{# Default content — 10 последних статей, скрывается при поиске #}
<div id="default-content">

    {# Category filters #}
    <div class="flex flex-wrap items-center gap-2 mb-6">
        <a href="{{ path('app_article_index') }}"
           class="badge cursor-pointer no-underline transition-colors
                  {{ currentCategory is null ? 'bg-[var(--primary)] text-[var(--primary-foreground)] border-[var(--primary)]' : 'hover:bg-[var(--accent)]' }}">
            Все
        </a>
        {% for category in categories %}
            <a href="{{ path('app_article_index', {category: category.slug}) }}"
               class="badge cursor-pointer no-underline transition-colors
                      {{ currentCategory and currentCategory.id == category.id ? 'bg-[var(--primary)] text-[var(--primary-foreground)] border-[var(--primary)]' : 'hover:bg-[var(--accent)]' }}">
                {{ category.name }}
            </a>
        {% endfor %}
    </div>

    {# Empty state #}
    {% if articles|length == 0 %}
        <div class="card p-12 text-center">
            <svg class="mx-auto mb-4 text-[var(--muted-foreground)]" width="40" height="40" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
            </svg>
            <p class="text-sm text-[var(--muted-foreground)]">Статей пока нет.</p>
        </div>
    {% endif %}

    {# Articles grid #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for article in articles %}
            <a href="{{ path('app_article_show', {id: article.id}) }}"
               class="card flex flex-col overflow-hidden no-underline group hover:shadow-md transition-shadow">

                {% if article.imageUrl %}
                    <div class="h-44 overflow-hidden bg-[var(--muted)] shrink-0">
                        <img src="{{ article.imageUrl }}" alt="{{ article.title }}"
                             class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                             onerror="this.parentElement.style.display='none'">
                    </div>
                {% endif %}

                <div class="flex flex-col flex-1 p-4 gap-2">
                    {% if article.category %}
                        <span class="badge self-start">{{ article.category.name }}</span>
                    {% endif %}

                    <h3 class="text-sm font-semibold leading-snug text-[var(--foreground)] line-clamp-3">
                        {{ article.title }}
                    </h3>

                    {% if article.summary %}
                        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed line-clamp-2 flex-1">
                            {{ article.summary }}
                        </p>
                    {% endif %}

                    <div class="flex items-center justify-between pt-1 mt-auto">
                        <span class="text-xs text-[var(--muted-foreground)]">
                            {{ article.publishedAt|date('d.m.Y') }}
                        </span>
                        {% if article.source %}
                            <span class="text-xs text-[var(--muted-foreground)] truncate max-w-[120px]">
                                {{ article.source.name }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
        <div class="flex justify-center mt-8">
            <div class="pagination">
                {% if currentPage > 1 %}
                    <a class="page-btn"
                       href="{{ path('app_article_index', {page: currentPage - 1, category: currentCategory ? currentCategory.slug : null}) }}">
                        &lsaquo;
                    </a>
                {% endif %}

                {% for p in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                    <a class="page-btn {{ p == currentPage ? 'active' : '' }}"
                       href="{{ path('app_article_index', {page: p, category: currentCategory ? currentCategory.slug : null}) }}">
                        {{ p }}
                    </a>
                {% endfor %}

                {% if currentPage < totalPages %}
                    <a class="page-btn"
                       href="{{ path('app_article_index', {page: currentPage + 1, category: currentCategory ? currentCategory.slug : null}) }}">
                        &rsaquo;
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}

</div>

{# Search results — показывается при активном поиске #}
<div id="search-results" class="hidden"></div>

{% endblock %}

{% block javascripts %}
<script>
(function () {
    'use strict';

    var input   = document.getElementById('search-input');
    if (!input) return;

    var defBox  = document.getElementById('default-content');
    var resBox  = document.getElementById('search-results');
    var spinner = document.getElementById('search-spinner');
    var url     = input.dataset.searchUrl;
    var timer   = null;

    /* ---- helpers ---- */

    function esc(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function highlight(text, query) {
        var safe = esc(text);
        if (!query) return safe;
        var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        return safe.replace(re, '<mark class="search-highlight">$1</mark>');
    }

    function safeImgUrl(u) {
        if (!u) return '';
        try {
            var p = new URL(u);
            return (p.protocol === 'https:' || p.protocol === 'http:') ? u : '';
        } catch (e) { return ''; }
    }

    function fmtDate(s) {
        if (!s) return '';
        var d = new Date(s);
        if (isNaN(d.getTime())) return '';
        return [
            String(d.getDate()).padStart(2, '0'),
            String(d.getMonth() + 1).padStart(2, '0'),
            d.getFullYear()
        ].join('.');
    }

    /* ---- card builder ---- */

    function renderCard(a, q) {
        var imgHtml = '';
        if (safeImgUrl(a.image_url)) {
            imgHtml =
                '<div class="h-44 overflow-hidden bg-[var(--muted)] shrink-0">' +
                '<img src="' + esc(a.image_url) + '" alt="' + esc(a.title) + '" ' +
                'class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" ' +
                'onerror="this.parentElement.style.display=\'none\'">' +
                '</div>';
        }
        var catHtml = a.category_name
            ? '<span class="badge self-start">' + esc(a.category_name) + '</span>'
            : '';
        var summaryHtml = a.summary
            ? '<p class="text-xs text-[var(--muted-foreground)] leading-relaxed line-clamp-2 flex-1">' +
              highlight(a.summary, q) + '</p>'
            : '';
        var srcHtml = a.source_name
            ? '<span class="text-xs text-[var(--muted-foreground)] truncate max-w-[120px]">' +
              esc(a.source_name) + '</span>'
            : '';

        return '<a href="/article/' + Number(a.id) + '" ' +
            'class="card flex flex-col overflow-hidden no-underline group hover:shadow-md transition-shadow">' +
            imgHtml +
            '<div class="flex flex-col flex-1 p-4 gap-2">' +
            catHtml +
            '<h3 class="text-sm font-semibold leading-snug text-[var(--foreground)] line-clamp-3">' +
            highlight(a.title, q) +
            '</h3>' +
            summaryHtml +
            '<div class="flex items-center justify-between pt-1 mt-auto">' +
            '<span class="text-xs text-[var(--muted-foreground)]">' + fmtDate(a.published_at) + '</span>' +
            srcHtml +
            '</div>' +
            '</div>' +
            '</a>';
    }

    /* ---- search logic ---- */

    function doSearch(q) {
        q = q.trim();

        if (q.length < 2) {
            defBox.classList.remove('hidden');
            resBox.classList.add('hidden');
            resBox.innerHTML = '';
            return;
        }

        spinner.classList.remove('hidden');

        fetch(url + '?q=' + encodeURIComponent(q), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                spinner.classList.add('hidden');
                defBox.classList.add('hidden');
                resBox.classList.remove('hidden');

                var list = data.articles || [];
                if (list.length === 0) {
                    resBox.innerHTML =
                        '<div class="card p-12 text-center">' +
                        '<svg class="mx-auto mb-4 text-[var(--muted-foreground)]" width="40" height="40" ' +
                        'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">' +
                        '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>' +
                        '</svg>' +
                        '<p class="text-sm text-[var(--muted-foreground)]">По запросу «' + esc(q) + '» ничего не найдено.</p>' +
                        '</div>';
                    return;
                }

                resBox.innerHTML =
                    '<p class="text-sm text-[var(--muted-foreground)] mb-4">Найдено: ' + list.length + '</p>' +
                    '<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">' +
                    list.map(function (a) { return renderCard(a, q); }).join('') +
                    '</div>';
            })
            .catch(function () {
                spinner.classList.add('hidden');
            });
    }

    input.addEventListener('input', function () {
        var q = this.value;
        clearTimeout(timer);
        timer = setTimeout(function () { doSearch(q); }, 300);
    });
}());
</script>
{% endblock %}
