{% extends 'base.html.twig' %}

{% block title %}Новости{% if currentCategory %} — {{ currentCategory.name }}{% endif %}{% endblock %}

{% block body %}
<div class="row">
    {# Фильтр по категориям #}
    <div class="col-12 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_article_index') }}"
               class="btn btn-sm {{ currentCategory is null ? 'btn-dark' : 'btn-outline-dark' }}">
                Все
            </a>
            {% for category in categories %}
                <a href="{{ path('app_article_index', {category: category.slug}) }}"
                   class="btn btn-sm {{ currentCategory and currentCategory.id == category.id ? 'btn-dark' : 'btn-outline-dark' }}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>
    </div>

    {# Список статей #}
    {% if articles|length == 0 %}
        <div class="col-12">
            <div class="alert alert-info">
                <i class="fa fa-info-circle me-2"></i>Статей пока нет. Запустите импорт командой
                <code>php bin/console app:news:import</code>
            </div>
        </div>
    {% endif %}

    {% for article in articles %}
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                {% if article.imageUrl %}
                    <img src="{{ article.imageUrl }}" class="card-img-top article-img" alt="{{ article.title }}"
                         onerror="this.style.display='none'">
                {% endif %}
                <div class="card-body d-flex flex-column">
                    {% if article.category %}
                        <span class="badge bg-secondary mb-2 badge-category">{{ article.category.name }}</span>
                    {% endif %}
                    <h5 class="card-title">
                        <a href="{{ path('app_article_show', {id: article.id}) }}" class="text-decoration-none text-dark">
                            {{ article.title|length > 90 ? article.title|slice(0, 90) ~ '…' : article.title }}
                        </a>
                    </h5>
                    {% if article.summary %}
                        <p class="card-text text-muted small flex-grow-1">
                            {{ article.summary|length > 150 ? article.summary|slice(0, 150) ~ '…' : article.summary }}
                        </p>
                    {% endif %}
                    <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fa fa-clock me-1"></i>{{ article.publishedAt|date('d.m.Y') }}
                        </small>
                        {% if article.source %}
                            <small class="text-muted">{{ article.source.name }}</small>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{# Пагинация #}
{% if totalPages > 1 %}
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            {% if currentPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_article_index', {page: currentPage - 1, category: currentCategory ? currentCategory.slug : null}) }}">
                        &laquo;
                    </a>
                </li>
            {% endif %}
            {% for p in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                    <a class="page-link" href="{{ path('app_article_index', {page: p, category: currentCategory ? currentCategory.slug : null}) }}">
                        {{ p }}
                    </a>
                </li>
            {% endfor %}
            {% if currentPage < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_article_index', {page: currentPage + 1, category: currentCategory ? currentCategory.slug : null}) }}">
                        &raquo;
                    </a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
{% endblock %}
