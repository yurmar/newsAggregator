<!DOCTYPE html>
<html lang="ru" class="">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}NewsAgg{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body class="min-h-screen bg-background text-foreground flex flex-col">

<div id="toast-container"
     style="position:fixed;top:1rem;right:1rem;z-index:9999;display:flex;flex-direction:column;gap:0.5rem;pointer-events:none;"
     aria-live="polite" aria-atomic="false"></div>

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between gap-6">

        <a href="{{ path('app_article_index') }}"
           class="flex items-center gap-2 font-semibold text-sm text-foreground shrink-0 no-underline">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/>
            </svg>
            NewsAgg
        </a>

        <nav class="flex items-center gap-1">
            <a href="{{ path('app_article_index') }}" class="nav-link">Все новости</a>
            {% if app.user %}
                <a href="{{ path('app_import_index') }}" class="nav-link">Импорт</a>
            {% endif %}
        </nav>

        <div class="flex items-center gap-2 shrink-0">

            <button id="theme-toggle" aria-label="Тема"
                    class="btn btn-ghost w-9 h-9 p-0 rounded-md">
                <svg id="icon-sun" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
                <svg id="icon-moon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
            </button>

            {% if app.user %}
                <a href="{{ path('app_notification_index') }}" aria-label="Уведомления"
                   class="btn btn-ghost w-9 h-9 p-0 rounded-md relative no-underline">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span id="notification-badge"
                          class="hidden absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 text-[10px] font-bold leading-4 text-center rounded-full bg-destructive" style="color:#fff"></span>
                </a>

                <div class="relative" id="user-menu-wrap">
                    <button id="user-menu-btn" class="btn btn-ghost h-9 px-3 gap-2 text-sm">
                        <span class="w-6 h-6 rounded-full bg-primary text-primary-foreground text-xs flex items-center justify-center font-bold">
                            {{ app.user.name|first|upper }}
                        </span>
                        <span class="hidden sm:inline">{{ app.user.name }}</span>
                        <svg class="w-3 h-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </button>
                    <div id="user-menu"
                         class="hidden absolute right-0 top-full mt-1 w-44 rounded-lg border border-border bg-card shadow-lg py-1 z-50">
                        <a href="{{ path('app_profile') }}"
                           class="flex items-center gap-2 px-3 py-2 text-sm text-foreground hover:bg-accent transition-colors no-underline">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                            </svg>
                            Профиль
                        </a>
                        <a href="{{ path('admin_dashboard') }}"
                           class="flex items-center gap-2 px-3 py-2 text-sm text-foreground hover:bg-accent transition-colors no-underline">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                            </svg>
                            Администрирование
                        </a>
                        <div class="my-1 border-t border-border"></div>
                        <a href="{{ path('app_logout') }}"
                           class="flex items-center gap-2 px-3 py-2 text-sm text-destructive hover:bg-accent transition-colors no-underline">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                            </svg>
                            Выйти
                        </a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav-link">Войти</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary h-9 px-4 text-sm no-underline">Регистрация</a>
            {% endif %}
        </div>

    </div>
</header>

<main class="flex-1 max-w-7xl mx-auto w-full px-6 py-8">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-4">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="border-t border-border">
    <div class="max-w-7xl mx-auto px-6 h-12 flex items-center justify-between">
        <span class="text-xs text-muted-foreground">&copy; {{ "now"|date("Y") }} NewsAggregator</span>
        <span class="text-xs text-muted-foreground">Enterprise News Platform</span>
    </div>
</footer>

<script>
(function () {
    var html = document.documentElement;
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (stored === 'dark' || (!stored && prefersDark)) html.classList.add('dark');

    function applyIcons() {
        var dark = html.classList.contains('dark');
        document.getElementById('icon-sun').classList.toggle('hidden', !dark);
        document.getElementById('icon-moon').classList.toggle('hidden', dark);
    }
    applyIcons();

    document.getElementById('theme-toggle').addEventListener('click', function () {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        applyIcons();
    });

    var menuBtn = document.getElementById('user-menu-btn');
    var menu = document.getElementById('user-menu');
    if (menuBtn && menu) {
        menuBtn.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('hidden'); });
        document.addEventListener('click', function () { menu.classList.add('hidden'); });
    }
})();
</script>

{% if app.user %}
<script>
(function () {
    /* ── Notification badge ── */
    function updateBadge() {
        fetch('{{ path('app_notification_count') }}')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var badge = document.getElementById('notification-badge');
                if (!badge) return;
                if (data.count > 0) { badge.textContent = data.count; badge.classList.remove('hidden'); }
                else { badge.classList.add('hidden'); }
            }).catch(function () {});
    }
    updateBadge();
    setInterval(updateBadge, 30000);

    /* ── Toast notifications ── */
    var ICONS   = { user_registered: '👤', user_login: '🔑', news_imported: '📰' };
    var COLORS  = { user_registered: '#2563eb', user_login: '#059669', news_imported: '#7c3aed' };

    function showToast(type, message) {
        var container = document.getElementById('toast-container');
        if (!container) return;

        var toast = document.createElement('div');
        toast.setAttribute('role', 'alert');
        toast.style.cssText = [
            'background:' + (COLORS[type] || '#475569'),
            'display:flex',
            'align-items:flex-start',
            'gap:0.75rem',
            'padding:0.75rem 1rem',
            'border-radius:0.5rem',
            'box-shadow:0 4px 6px -1px rgba(0,0,0,.25)',
            'color:#fff',
            'font-size:0.875rem',
            'line-height:1.4',
            'cursor:pointer',
            'pointer-events:auto',
            'width:20rem',
            'max-width:calc(100vw - 2rem)',
            'transform:translateX(120%)',
            'transition:transform .3s ease-out',
        ].join(';');

        toast.innerHTML =
            '<span style="font-size:1.1rem;flex-shrink:0;margin-top:.05rem">' + (ICONS[type] || 'ℹ️') + '</span>' +
            '<span style="flex:1">' + message + '</span>';

        function dismiss() {
            toast.style.transform = 'translateX(120%)';
            toast.addEventListener('transitionend', function () { toast.remove(); }, { once: true });
        }

        toast.addEventListener('click', function () { clearTimeout(timer); dismiss(); });
        container.appendChild(toast);

        requestAnimationFrame(function () {
            requestAnimationFrame(function () { toast.style.transform = 'translateX(0)'; });
        });

        var timer = setTimeout(dismiss, 5000);
    }

    /* ── SSE via Mercure ── */
    try {
        var hubUrl = new URL('{{ mercure_public_url }}');
        hubUrl.searchParams.append('topic', '/notifications/broadcast');

        var es = new EventSource(hubUrl.toString());
        es.onmessage = function (e) {
            try {
                var data = JSON.parse(e.data);
                if (data.type && data.message) {
                    showToast(data.type, data.message);
                    if (data.type === 'news_imported') {
                        updateBadge();
                    }
                }
            } catch (_) {}
        };
        es.onerror = function () { /* Mercure недоступен — продолжаем с поллингом */ };
    } catch (_) {}
})();
</script>
{% endif %}

{% block javascripts %}{% endblock %}
</body>
</html>
