{% extends 'base.html.twig' %}

{% block title %}Подтверждение регистрации — NewsAgg{% endblock %}

{% block body %}
<div class="flex justify-center items-start pt-8">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-[var(--foreground)]">Подтверждение аккаунта</h1>
            <p class="mt-1 text-sm text-[var(--muted-foreground)]">
                Введите 6-значный код подтверждения
            </p>
        </div>

        <div class="card p-6">

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger text-sm mb-4">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('info') %}
                <div class="alert alert-info text-sm mb-4">{{ message }}</div>
            {% endfor %}

            {% if error %}
                <div class="alert alert-danger text-sm mb-4">{{ error }}</div>
            {% endif %}

            {% if not blocked %}
                <form method="post" class="space-y-4">
                    <div>
                        <label for="code" class="block text-sm font-medium mb-1">Код подтверждения</label>
                        <input
                            type="text"
                            id="code"
                            name="code"
                            maxlength="6"
                            pattern="\d{6}"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            placeholder="000000"
                            required
                            autofocus
                            class="block w-full text-center text-xl tracking-widest"
                        >
                        {% if attemptsLeft > 0 and attemptsLeft < 3 %}
                            <p class="mt-1 text-xs text-[var(--muted-foreground)]">
                                Осталось попыток: {{ attemptsLeft }}
                            </p>
                        {% endif %}
                    </div>

                    <button type="submit" class="btn btn-primary w-full mt-2">
                        Подтвердить
                    </button>
                </form>
            {% else %}
                <div class="text-center py-4">
                    <p class="text-sm text-[var(--muted-foreground)]">
                        Код заблокирован. Запросите новый код или зарегистрируйтесь заново.
                    </p>
                </div>
            {% endif %}

            <div class="mt-4 text-center">
                {% if secondsUntilResend > 0 %}
                    <p class="text-sm text-[var(--muted-foreground)]">
                        Получить новый код через
                        <span id="resend-countdown">{{ secondsUntilResend }}</span> сек.
                    </p>
                    <script>
                        (function () {
                            var el = document.getElementById('resend-countdown');
                            var seconds = parseInt(el.textContent, 10);
                            var interval = setInterval(function () {
                                seconds--;
                                if (seconds <= 0) {
                                    clearInterval(interval);
                                    el.closest('p').outerHTML =
                                        '<form method="post" action="{{ path('app_verify_resend') }}">' +
                                        '<button type="submit" class="text-sm text-[var(--foreground)] font-medium hover:underline">Получить новый код</button>' +
                                        '</form>';
                                } else {
                                    el.textContent = seconds;
                                }
                            }, 1000);
                        })();
                    </script>
                {% else %}
                    <form method="post" action="{{ path('app_verify_resend') }}">
                        <button type="submit" class="text-sm text-[var(--foreground)] font-medium hover:underline">
                            Получить новый код
                        </button>
                    </form>
                {% endif %}
            </div>

        </div>

        <p class="text-center mt-4 text-sm text-[var(--muted-foreground)]">
            Уже есть аккаунт?
            <a href="{{ path('app_login') }}" class="text-[var(--foreground)] font-medium hover:underline">
                Войти
            </a>
        </p>
    </div>
</div>
{% endblock %}
