{% extends 'base.html.twig' %}

{% block title %}Регистрация — NewsAgg{% endblock %}

{% block stylesheets %}
<style>
    .registration-form input[type="text"],
    .registration-form input[type="email"],
    .registration-form input[type="password"] {
        display: block;
        width: 100%;
    }
    .registration-form ul {
        margin: 0.25rem 0 0;
        padding: 0 0 0 1rem;
        font-size: 0.75rem;
        color: var(--destructive);
    }
</style>
{% endblock %}

{% block body %}
<div class="flex justify-center items-start pt-8">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-[var(--foreground)]">Создать аккаунт</h1>
            <p class="mt-1 text-sm text-[var(--muted-foreground)]">Заполните данные для регистрации</p>
        </div>

        <div class="card p-6">

            {{ form_start(registrationForm, {
                attr: { novalidate: 'novalidate', class: 'registration-form space-y-4' }
            }) }}

            {% if registrationForm.vars.errors|length > 0 %}
                <div class="alert alert-danger text-sm mb-4">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            <div>
                {{ form_label(registrationForm.name) }}
                {{ form_widget(registrationForm.name, {attr: {placeholder: 'Ваше имя'}}) }}
                {{ form_errors(registrationForm.name) }}
            </div>

            <div>
                {{ form_label(registrationForm.email) }}
                {{ form_widget(registrationForm.email, {attr: {placeholder: 'email@example.com'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword.first) }}
                {{ form_widget(registrationForm.plainPassword.first, {attr: {placeholder: '••••••••'}}) }}
                {{ form_errors(registrationForm.plainPassword.first) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword.second) }}
                {{ form_widget(registrationForm.plainPassword.second, {attr: {placeholder: '••••••••'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <button type="submit" class="btn btn-primary w-full mt-2">
                Зарегистрироваться
            </button>

            {{ form_end(registrationForm) }}
        </div>

        <p class="text-center mt-4 text-sm text-[var(--muted-foreground)]">
            Уже есть аккаунт?
            <a href="{{ path('app_login') }}" class="text-[var(--foreground)] font-medium hover:underline">
                Войти
            </a>
        </p>
    </div>
</div>
{% endblock %}
