{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Панель управления{% endblock %}

{% block main %}
<div class="row g-4 mb-4">

    {# Статьи #}
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 p-2" style="background: #e8f4fd;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2196f3" stroke-width="2">
                            <path d="M4 4h16v2H4zM4 10h16v2H4zM4 16h10v2H4z"/>
                        </svg>
                    </div>
                    <span class="badge text-bg-primary rounded-pill">всего</span>
                </div>
                <div class="mt-auto">
                    <div class="display-6 fw-bold lh-1 mb-1">{{ stats.articles }}</div>
                    <div class="text-muted small fw-medium">Статьи</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 px-4 pb-3">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\ArticleCrudController') }}"
                   class="btn btn-sm btn-outline-primary w-100">Открыть список →</a>
            </div>
        </div>
    </div>

    {# Источники #}
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 p-2" style="background: #e8f8f0;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2">
                            <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
                        </svg>
                    </div>
                    <span class="badge text-bg-success rounded-pill">{{ stats.sourcesActive }} активных</span>
                </div>
                <div class="mt-auto">
                    <div class="display-6 fw-bold lh-1 mb-1">{{ stats.sources }}</div>
                    <div class="text-muted small fw-medium">Источники новостей</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 px-4 pb-3">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\NewsSourceCrudController') }}"
                   class="btn btn-sm btn-outline-success w-100">Открыть список →</a>
            </div>
        </div>
    </div>

    {# Пользователи #}
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 p-2" style="background: #fff8e1;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff9800" stroke-width="2">
                            <circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0-3-3.85"/>
                        </svg>
                    </div>
                    <span class="badge text-bg-warning rounded-pill">{{ stats.usersVerified }} подтверждено</span>
                </div>
                <div class="mt-auto">
                    <div class="display-6 fw-bold lh-1 mb-1">{{ stats.users }}</div>
                    <div class="text-muted small fw-medium">Пользователи</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 px-4 pb-3">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}"
                   class="btn btn-sm btn-outline-warning w-100">Открыть список →</a>
            </div>
        </div>
    </div>

    {# Коды подтверждения #}
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 p-2" style="background: #f3e5f5;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9c27b0" stroke-width="2">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                        </svg>
                    </div>
                    <span class="badge text-bg-secondary rounded-pill">{{ stats.codesPending }} ожидают</span>
                </div>
                <div class="mt-auto">
                    <div class="display-6 fw-bold lh-1 mb-1">{{ stats.codes }}</div>
                    <div class="text-muted small fw-medium">Коды подтверждения</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 px-4 pb-3">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\VerificationCodeCrudController') }}"
                   class="btn btn-sm btn-outline-secondary w-100">Открыть список →</a>
            </div>
        </div>
    </div>

</div>

{# Вторая строка #}
<div class="row g-4">

    {# Прогресс регистраций #}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h6 class="text-muted text-uppercase fw-semibold small mb-3">Регистрации пользователей</h6>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">Подтверждено</span>
                    <span class="fw-bold">{{ stats.usersVerified }} / {{ stats.users }}</span>
                </div>
                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success"
                         style="width: {{ stats.users > 0 ? (stats.usersVerified / stats.users * 100)|round : 0 }}%"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">Не подтверждено</span>
                    <span class="fw-bold text-danger">{{ stats.users - stats.usersVerified }}</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-danger"
                         style="width: {{ stats.users > 0 ? ((stats.users - stats.usersVerified) / stats.users * 100)|round : 0 }}%"></div>
                </div>
            </div>
        </div>
    </div>

    {# Источники и категории #}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h6 class="text-muted text-uppercase fw-semibold small mb-3">Контент</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 p-2" style="background: #e3f2fd;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1976d2" stroke-width="2">
                                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold fs-5">{{ stats.categories }}</div>
                                <div class="text-muted small">Категорий</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 p-2" style="background: #e8f5e9;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#388e3c" stroke-width="2">
                                    <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold fs-5">{{ stats.sourcesActive }}</div>
                                <div class="text-muted small">Активных источников</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 p-2" style="background: #fce4ec;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c62828" stroke-width="2">
                                    <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold fs-5">{{ stats.sources - stats.sourcesActive }}</div>
                                <div class="text-muted small">Неактивных источников</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 p-2" style="background: #fff3e0;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e65100" stroke-width="2">
                                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold fs-5">{{ stats.codesPending }}</div>
                                <div class="text-muted small">Ожидают подтверждения</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
